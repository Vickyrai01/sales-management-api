# ==========================================
# Sales Management API - Environment Example
# ==========================================
# Copy this file to ".env" and adjust values if needed:
#   cp .env.example .env
#
# Notes:
# - These variables are used by docker-compose.yml to configure MySQL and the API container.
# - Do NOT commit your real .env file.

# --------------------------
# MySQL (container)
# --------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=sales_management
MYSQL_USER=app
MYSQL_PASSWORD=app

# --------------------------
# API (Spring Boot container)
# --------------------------
# IMPORTANT:
# - In docker-compose, the DB host is usually the service name: "mysql"
# - The database is exposed to your host at port 3307 (see docker-compose)
DB_URL=jdbc:mysql://mysql:3306/${MYSQL_DATABASE}?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USER=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# Hibernate schema management
# Recommended when using Flyway:
# - validate: verifies schema matches entities
# - none: disables DDL generation
DDL_AUTO=validate
